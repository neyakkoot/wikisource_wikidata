    // 9. பக்கச் செயலாக்கம்
    // ========================================================

    function processDictionaryPage() {
        currentUser = mw.config.get('wgUserName');
        if (!currentUser) { alert(T.loginRequired); return; }

        rawHeadwordsList = [];
        filteredLexemesList = [];
        currentIndex = 0;
        skippedCount = 0;

        extractDictionaryHeadwords().forEach(w => addHeadword(w));

        if (rawHeadwordsList.length === 0) {
            alert(T.noWords);
            return;
        }

        $('#import-lexeme-btn').text(T.buttonBusy).prop('disabled', true);

        getWikidataToken()
            .then(() => filterUncreatedLexemes())
            .then(function () {
                if (filteredLexemesList.length === 0) {
                    alert(T.allExist);
                    $('#import-lexeme-btn').text(T.button).prop('disabled', false);
                    return Promise.reject('STOP');
                }
                return batchFetchWiktionaryPOS();
            })
            .then(function (completed) {
                if (completed === false) return;
                showInteractiveModal();
            })
            .catch(function (error) {
                if (error === 'STOP') return;
                console.error(error);
                $('#import-lexeme-btn').text(T.button).prop('disabled', false);
                alert(T.apiError + '\n\n' + (error.message || error));
            });
    }

    // ========================================================
    // 10. CSRF token
    // ========================================================

    function getWikidataToken() {
        return wikidataApi.get({
            action: 'query', meta: 'tokens', type: 'csrf',
            assert: 'user', formatversion: 2
        }).then(function (data) {
            if (data?.query?.tokens?.csrftoken) {
                csrfToken = data.query.tokens.csrftoken;
                return true;
            }
            throw new Error(T.errToken);
        });
    }

    // ========================================================
    // 11. lexeme சரிபார்ப்பு
    // ========================================================

    function checkExactWikidataLexeme(word) {
        return wikidataApi.get({
            action: 'wbsearchentities',
            search: word,
            language: CURRENT_LANG_CODE,
            type: 'lexeme',
            limit: 50,
            formatversion: 2
        }).then(function (data) {
            if (!data || !Array.isArray(data.search) || !data.search.length) return false;

            const ids = data.search
                .map(r => r.id)
                .filter(id => /^L\d+$/.test(id));
            if (!ids.length) return false;

            return wikidataApi.get({
                action: 'wbgetentities',
                ids: ids.join('|'),
                props: 'lemmas|language|lexicalCategory',
                languages: CURRENT_LANG_CODE,
                formatversion: 2
            }).then(function (entityData) {
                if (!entityData || !entityData.entities) return false;
                const norm = normalizeWord(word);

                for (const id in entityData.entities) {
                    const ent = entityData.entities[id];
                    if (!ent || !ent.lemmas || !ent.lemmas[CURRENT_LANG_CODE]) continue;
                    const lemmaVal = normalizeWord(ent.lemmas[CURRENT_LANG_CODE].value || '');
                    if (lemmaVal !== norm) continue;
                    const langId = ent.language && ent.language.id;
                    if (langId && langId !== CURRENT_LANG_QID) continue;
                    return true;
                }
                return false;
            });
        }).catch(function (err) {
            console.warn('Lexeme check failed for', word, err);
            return false;
        });
    }

    async function filterUncreatedLexemes() {
        const concurrency = 5;
        const results = [];
        const queue = rawHeadwordsList.slice();

        async function worker() {
            while (queue.length) {
                const item = queue.shift();
                try {
                    const exists = await checkExactWikidataLexeme(item.lemma);
                    if (!exists) results.push(item);
                } catch (err) {
                    console.warn('Check failed:', item.lemma, err);
                    results.push(item);
                }
            }
        }

        await Promise.all(Array.from({ length: concurrency }, worker));
        filteredLexemesList = results;
        $('#import-lexeme-btn').text(T.button).prop('disabled', false);
        return true;
    }

    // ========================================================
    // 12. Wiktionary தரவு
    // ========================================================

    function getWiktionaryPage(word) {
        return wiktionaryApi.get({
            action: 'query', titles: word, redirects: 1,
            prop: 'info|revisions', rvprop: 'content',
            rvslots: 'main', formatversion: 2
        }).then(function (data) {
            if (!data?.query?.pages?.[0] || data.query.pages[0].missing !== undefined) {
                return { exists: false, content: '' };
            }
            const page = data.query.pages[0];
            let content = '';
            try {
                if (page.revisions?.[0]?.slots?.main?.content)
                    content = page.revisions[0].slots.main.content;
                else if (page.revisions?.[0]?.content)
                    content = page.revisions[0].content;
            } catch (e) { content = ''; }
            return { exists: true, content, title: page.title || word };
        });
    }

    function detectLexicalCategory(content) {
        if (!content) return 'Q1084';
        const posMap = CONFIG.pos;
        for (const qid in posMap) {
            for (const t of posMap[qid]) {
                if (content.includes('{{' + t + '}}') ||
                    content.includes('===' + t + '===') ||
                    content.includes('=== ' + t + ' ===')) {
                    return qid;
                }
            }
        }
        return 'Q1084';
    }

    function extractSensesFromWiktionary(content) {
        if (!content) return [];
        const senses = [];
        const lines = content.split(/\r?\n/);
        let inDefinitions = false;

        lines.forEach(function (line) {
            const trimmed = line.trim();
            if (/^==+\s*பொருள்\s*==+/i.test(trimmed) ||
                /^==+\s*Meaning\s*==+/i.test(trimmed)) {
                inDefinitions = true;
                return;
            }
            if (inDefinitions) {
                if (/^==+/.test(trimmed) && !/பொருள்|Meaning/.test(trimmed)) {
                    inDefinitions = false;
                    return;
                }
                const m = trimmed.match(/^#\s*(?!\*)(.+)$/);
                if (m && m[1]) {
                    const gloss = m[1]
                        .replace(/\[\[([^\]|]+)\|?([^\]]*)\]\]/g, (_, a, b) => b || a)
                        .replace(/\{\{[^}]*\}\}/g, '').trim();
                    if (gloss && gloss.length > 0) senses.push(gloss);
                }
            }
        });

        return senses.slice(0, 10);
    }

    async function batchFetchWiktionaryPOS() {
        const concurrency = 5;
        const queue = filteredLexemesList.slice();

        async function worker() {
            while (queue.length) {
                const item = queue.shift();
                try {
                    const result = await getWiktionaryPage(item.lemma);
                    if (result.exists) {
                        item.inWiktionary = true;
                        item.wiktionaryContent = result.content || '';
                        item.wiktionaryTitle = result.title || item.lemma;
                        item.lexicalCategory = detectLexicalCategory(result.content);
                        item.senses = extractSensesFromWiktionary(result.content);
                    } else {
                        item.inWiktionary = false;
                        item.wiktionaryContent = '';
                        item.wiktionaryTitle = item.lemma;
                        item.senses = [];
                    }
                } catch (err) {
                    console.warn('Wiktionary fetch failed:', item.lemma, err);
                    item.inWiktionary = false;
                    item.senses = [];
                }
            }
        }

        await Promise.all(Array.from({ length: concurrency }, worker));
        return true;
    }

    // ========================================================
    // 13. Commons ஒலி
    // ========================================================

    function checkCommonsAudioFile(fileName) {
        if (!fileName) return Promise.resolve(null);
        return commonsApi.get({
            action: 'query', titles: 'File:' + fileName,
            prop: 'imageinfo', iiprop: 'mime', formatversion: 2
        }).then(function (data) {
            const page = data?.query?.pages?.[0];
            if (!page || page.missing !== undefined) return null;
            const mime = (page.imageinfo?.[0]?.mime || '').toLowerCase();
            return mime.indexOf('audio/') === 0 ? fileName : null;
        }).catch(() => null);
    }

    function findStandardCommonsAudio(word) {
        const candidates = AUDIO_EXTENSIONS.map(ext =>
            AUDIO_PREFIX + '-' + word + '.' + ext);
        return commonsApi.get({
            action: 'query', titles: candidates.join('|'),
            prop: 'imageinfo', iiprop: 'mime', formatversion: 2
        }).then(function (data) {
            const pages = data?.query?.pages || [];
            for (const page of pages) {
                if (page.missing !== undefined) continue;
                const mime = (page.imageinfo?.[0]?.mime || '').toLowerCase();
                if (mime.indexOf('audio/') === 0) {
                    return (page.title || '').replace(/^File:/i, '');
                }
            }
            return null;
        }).catch(() => null);
    }

    function extractAudioFilesFromWiktionary(content) {
        if (!content) return [];
        const results = [];
        const nsPattern = FILE_NAMESPACES
            .map(ns => ns.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
            .join('|');
        const regex = new RegExp(
            '(?:commons\\s*:\\s*)?(?:' + nsPattern + ')\\s*:\\s*([^|\\]\\n<>"]+\\.(?:' +
            AUDIO_EXTENSIONS.join('|') + '))', 'gi');
        let match;
        while ((match = regex.exec(content)) !== null) {
            const f = match[1].trim();
            if (f && !results.includes(f)) results.push(f);
        }
        return results;
    }

    function findCommonsPronunciationAudio(word, wiktionaryContent) {
        return findStandardCommonsAudio(word).then(function (std) {
            if (std) return std;
            const files = extractAudioFilesFromWiktionary(wiktionaryContent);
            if (!files.length) return null;
            let promise = Promise.resolve(null);
            files.forEach(function (f) {
                promise = promise.then(found => found || checkCommonsAudioFile(f));
            });
            return promise;
        });
    }

    // ========================================================
    // 14. P443 claim
    // ========================================================

    function buildPronunciationAudioClaim(audioFileName) {
        return {
            mainsnak: {
                snaktype: 'value', property: P443_PRONUNCIATION_AUDIO,
                datavalue: { value: audioFileName, type: 'string' }
            },
            type: 'statement', rank: 'normal',
            qualifiers: {
                P407: [{
                    snaktype: 'value', property: P407_LANGUAGE,
                    datavalue: {
                        value: {
                            'entity-type': 'item',
                            'numeric-id': CURRENT_LANG_NUMERIC,
                            'id': CURRENT_LANG_QID
                        },
                        type: 'wikibase-entityid'
                    }
                }]
            },
            'qualifiers-order': ['P407']
        };
    }

