    /**
     * தமிழின் இறுதி எழுத்துகள் → இணைப்பு மெய் (linking consonant)
     *
     * எ.கா.:
     *   கவி (இ இறுதி) → கவி + ய் + ஐ = கவியை
     *   நிலா (ஆ இறுதி) → நிலா + வ் + ஐ = நிலாவை
     *   குரு (உ இறுதி) → குரு + வ் + ஐ = குருவை
     *   மரம் (ம் இறுதி) → மர + த் + ஐ = மரத்தை
     *   ஐயன் (ன் இறுதி) → ஐயன் + ஐ = ஐயனை (ன் → ன்)
     */
    function getLinkingConsonant(word) {
        if (!word) return '';

        const last = word.slice(-1);

        // உயிர் இறுதிகள் (vowels) → இணைப்பு மெய்
        if (last === 'இ' || last === 'ஈ' || last === 'ஐ') return 'ய்';
        if (last === 'அ' || last === 'ஆ' || last === 'ஐ') return 'வ்';
        if (last === 'உ' || last === 'ஊ' || last === 'ஔ') return 'வ்';
        if (last === 'எ' || last === 'ஏ' || last === 'ஒ' || last === 'ஓ') return 'வ்';

        // மெய் இறுதிகள் (consonants)
        if (last === 'ம்') return 'த்';
        if (last === 'ன்') return '';   // சிறப்பு — ன் → ன் மாற்றம்
        if (last === 'ல்') return 'இ';
        if (last === 'ய்' || last === 'ர்' || last === 'ழ்' || last === 'ள்') return '';

        // இயல்புநிலை — உயிர் முடிவு
        if (/[\u0B85-\u0B94]/.test(last)) return 'வ்';

        return '';
    }

    /**
     * இறுதி எழுத்தை மாற்று (எ.கா. ன் → ன, ம் → த்)
     */
    function transformWordEnd(word, caseType) {
        if (!word) return '';

        const last = word.slice(-1);

        // ன் இறுதி — வேற்றுமை விகுதிக்கு முன் ன் → ன
        if (last === '்' && word.slice(-2) === 'ன்') {
            return word.slice(0, -2) + 'ன';
        }

        // ம் இறுதி — த்/த்த் ஆக மாற்று
        if (last === '்' && word.slice(-2) === 'ம்') {
            return word.slice(0, -2) + 'த';
        }

        return word;
    }

    /**
     * சொல்லின் இறுதி + வேற்றுமை → சரியான வடிவம்
     */
    function applyTamilSuffix(word, caseType) {
        if (!word) return '';

        // எழுவாய் — அப்படியே
        if (caseType === 'NOMINATIVE') return word;

        // சொல்லின் அடிப்படையை மாற்று (எ.கா. ம் → த்)
        const base = transformWordEnd(word, caseType);

        // ன் இறுதி → சிறப்பு விதி
        const lastChar = word.slice(-1);
        const lastTwo = word.slice(-2);
        if (lastTwo === 'ன்') {
            // ஐயன் → ஐயனை (விகுதி நேரடியாக)
            switch (caseType) {
                case 'ACCUSATIVE':   return base + 'ஐ';
                case 'INSTRUMENTAL': return base + 'ஆல்';
                case 'DATIVE':       return base + 'க்கு';
                case 'ABLATIVE':     return base + 'இலிருந்து';
                case 'GENITIVE':     return base + 'இன்';
                case 'LOCATIVE':     return base + 'இல்';
                case 'VOCATIVE':     return base + 'ஏ';
            }
            return base;
        }

        // மம் இறுதி → த் + விகுதி (மரம் → மரத்தை, மரத்தால், மரத்திற்கு)
        if (lastTwo === 'ம்') {
            switch (caseType) {
                case 'ACCUSATIVE':   return base + 'தை';
                case 'INSTRUMENTAL': return base + 'தால்';
                case 'DATIVE':       return base + 'திற்கு';
                case 'ABLATIVE':     return base + 'திலிருந்து';
                case 'GENITIVE':     return base + 'தின்';
                case 'LOCATIVE':     return base + 'தில்';
                case 'VOCATIVE':     return base + 'தே';
            }
            return base;
        }

        // உயிர் இறுதி — இணைப்பு மெய் சேர்
        const link = getLinkingConsonant(word);

        switch (caseType) {
            case 'ACCUSATIVE':
                return base + link + 'ஐ';
            case 'INSTRUMENTAL':
                return base + link + 'ஆல்';
            case 'DATIVE':
                return base + link + 'க்கு';
            case 'ABLATIVE':
                return base + link + 'இலிருந்து';
            case 'GENITIVE':
                return base + link + 'இன்';
            case 'LOCATIVE':
                return base + link + 'இல்';
            case 'VOCATIVE':
                return base + link + 'ஏ';
        }

        return base;
    }

    // வேற்றுமைகளின் வரிசை மற்றும் விவரம்
    const TAMIL_CASES = [
        { key: 'NOMINATIVE',   qid: GRAM_FEATURES.NOMINATIVE,   label: 'எழுவாய் வேற்றுமை' },
