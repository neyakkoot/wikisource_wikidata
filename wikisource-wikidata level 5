    // ========================================================
    // 16. Lexeme உருவாக்கம் — Forms + Senses உடன்
    // ========================================================

    function createLexeme(lemmaVal, langVal, catVal, audioFileName, options) {
        options = options || {};
        const autoForms = options.autoForms !== false;
        const item = options.item || {};

        // ---- Forms ----
        let formsData = [];
        if (autoForms && DECLENSION_ENABLED && catVal === 'Q1084') {
            const generated = generateTamilForms(lemmaVal);
            formsData = generated.map(f => {
                const rep = {};
                rep[CURRENT_LANG_CODE] = {
                    language: CURRENT_LANG_CODE,
                    value: f.representation
                };
                return {
                    representations: rep,
                    grammaticalFeatures: f.features.filter(Boolean)
                };
            });
        } else {
            const rep = {};
            rep[CURRENT_LANG_CODE] = {
                language: CURRENT_LANG_CODE,
                value: lemmaVal
            };
            formsData = [{
                representations: rep,
                grammaticalFeatures: []
            }];
        }

        // ---- Senses ----
        let sensesData = [];
        const senseGlosses = (item.senses && item.senses.length)
            ? item.senses
            : [lemmaVal];
        if (senseGlosses.length) {
            const glosses = {};
            glosses[CURRENT_LANG_CODE] = {
                language: CURRENT_LANG_CODE,
                value: senseGlosses.join('; ')
            };
            sensesData.push({ glosses: glosses });
        }

        // ---- Lexeme JSON ----
        const lemmas = {};
        lemmas[CURRENT_LANG_CODE] = {
            language: CURRENT_LANG_CODE,
            value: lemmaVal
        };

        const lexemeData = {
            type: 'lexeme',
            lemmas: lemmas,
            lexicalCategory: catVal,
            language: langVal,
            forms: formsData,
            senses: sensesData
        };

        return wikidataApi.post({
            action: 'wbeditentity',
            new: 'lexeme',
            data: JSON.stringify(lexemeData),
            summary: 'Created from Wikisource (' + SITE_LANG + ') with ' +
                formsData.length + ' form(s) and ' +
                sensesData.length + ' sense(s) | User: ' + currentUser,
            token: csrfToken,
            assert: 'user',
            format: 'json'
        }).then(function (data) {
            if (!data || !data.success || !data.entity || !data.entity.id) {
                throw new Error((data?.error?.info) || T.errCreate);
            }
            const lexemeId = data.entity.id;

            if (!audioFileName) {
                return {
                    lexemeId: lexemeId, formId: null,
                    audioFileName: null, formsCount: formsData.length,
                    sensesCount: sensesData.length
                };
            }

            return getFirstFormId(lexemeId).then(function (formId) {
                if (!formId) {
                    return {
                        lexemeId: lexemeId, formId: null,
                        audioFileName: null, formsCount: formsData.length,
                        sensesCount: sensesData.length
                    };
                }
                return addPronunciationToForm(formId, audioFileName).then(function () {
                    return {
                        lexemeId: lexemeId, formId: formId,
                        audioFileName: audioFileName,
                        formsCount: formsData.length,
                        sensesCount: sensesData.length
                    };
                });
            });
        });
    }

    function getFirstFormId(lexemeId) {
        return wikidataApi.get({
            action: 'wbgetentities', ids: lexemeId,
            props: 'forms', formatversion: 2
        }).then(function (data) {
            const entity = data?.entities?.[lexemeId];
            if (!entity || !entity.forms) return null;
            if (Array.isArray(entity.forms)) {
                return entity.forms.length ? entity.forms[0].id : null;
            }
            const keys = Object.keys(entity.forms);
            return keys.length ? keys[0] : null;
        });
    }

    function addPronunciationToForm(formId, audioFileName) {
        const claim = buildPronunciationAudioClaim(audioFileName);
        return wikidataApi.post({
            action: 'wbeditentity', id: formId,
            data: JSON.stringify({ claims: [claim] }),
            summary: 'Added pronunciation audio from Commons | ' + audioFileName,
            token: csrfToken, assert: 'user', format: 'json'
        }).then(function (data) {
            if (!data || !data.success) {
                throw new Error((data?.error?.info) || T.errP443);
            }
            return true;
        });
    }

    // ========================================================
    // 17. சமர்ப்பிப்பு
    // ========================================================

    function submitCurrentLexeme() {
        const lemmaVal = $('#input-lemma').val().trim();
        const langVal = extractQID($('#input-language').val().trim());
        const catVal = extractQID($('#input-category').val().trim());
        const autoForms = DECLENSION_ENABLED
            ? $('#auto-forms-checkbox').is(':checked')
            : false;

        if (!lemmaVal || !langVal || !catVal) {
            alert(T.fillAll);
            return;
        }

        $('#submit-lexeme-btn').prop('disabled', true).text(T.creating2);
        $('#skip-lexeme-btn').prop('disabled', true);
        $('#status-msg').text(T.audioSearching).css('color', '#00af89');

        const item = filteredLexemesList[currentIndex];

        findCommonsPronunciationAudio(lemmaVal, item ? item.wiktionaryContent : '')
            .then(function (audioFileName) {
                if (audioFileName) {
                    $('#audio-status-box').css({
                        background: '#e6f9ed', borderColor: '#00af89', color: '#006633'
                    }).html(T.audioFound + ': <strong>' +
                        escapeHtml(audioFileName) + '</strong>');
                } else {
                    $('#audio-status-box').css({
                        background: '#fffbe6', borderColor: '#fc0', color: '#665500'
                    }).html(T.audioNotFound);
                }
                $('#status-msg').text(T.creating).css('color', '#00af89');

                return createLexeme(lemmaVal, langVal, catVal, audioFileName, {
                    autoForms: autoForms,
                    item: item
                });
            })
            .then(function (result) {
                if (!result) return;
                let message = T.success + ': ' + escapeHtml(lemmaVal) +
                    ' (' + result.lexemeId + ') ' + T.created + '!';
                message += '<br>📋 Forms: ' + result.formsCount +
                    ' | Senses: ' + result.sensesCount;
                if (result.audioFileName && result.formId) {
                    message += '<br>🔊 P443: ' + escapeHtml(result.audioFileName);
                }
                $('#status-msg').html(message).css('color', 'green');

                const lexemeUrl = 'https://www.wikidata.org/wiki/' + result.lexemeId;
                let linkHtml = '<a href="' + lexemeUrl +
                    '" target="_blank" style="color:#36c;">' + result.lexemeId + '</a>';
                if (result.formId) {
                    const formUrl = 'https://www.wikidata.org/wiki/' + result.formId;
                    linkHtml += ' / <a href="' + formUrl +
                        '" target="_blank" style="color:#36c;">' + result.formId + '</a>';
                }
                $('#status-msg').append('<br>' + linkHtml);

                setTimeout(nextWord, 1400);
            })
            .catch(function (error) {
                console.error(error);
                $('#status-msg').text('❌ ' + (error.message || error)).css('color', 'red');
                $('#submit-lexeme-btn').prop('disabled', false).text(T.createLexeme);
                $('#skip-lexeme-btn').prop('disabled', false);
            });
    }

    function nextWord() {
        currentIndex++;
        if (currentIndex < filteredLexemesList.length) {
            loadCurrentWordToForm();
            return;
        }
        $('#lexeme-modal-overlay').remove();
        if (skippedCount > 0) {
            alert(T.allDone + '\n(Skipped: ' + skippedCount + ')');
        } else {
            alert(T.allDone);
        }
    }

    // ========================================================
    // 18. துவக்கம்
    // ========================================================

    mw.loader.using('mediawiki.ForeignApi').then(function () {
        initializeApis();
        $(document).ready(addImportButton);
    });

})();
