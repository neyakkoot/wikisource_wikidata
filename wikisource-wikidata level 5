    /**
     * தமிழ் பெயர்ச்சொல்லின் அனைத்து வேற்றுமை வடிவங்கள்
     */
    function generateTamilForms(lemma) {
        const forms = [];
        const base = normalizeWord(lemma);
        if (!base) return forms;

        // 8 வேற்றுமைகள் (ஒருமை)
        for (const c of TAMIL_CASES) {
            const form = applyTamilSuffix(base, c.key);
            if (!form) continue;
            forms.push({
                representation: form,
                features: [c.qid, GRAM_FEATURES.SINGULAR]
            });
        }

        // பன்மை எழுவாய் — 'கள்' சேர்ப்பு
        const pluralBase = transformWordEnd(base, 'PLURAL');
        const plural = pluralBase + 'கள்';
        if (plural && !forms.some(f => f.representation === plural)) {
            forms.push({
                representation: plural,
                features: [GRAM_FEATURES.NOMINATIVE, GRAM_FEATURES.PLURAL]
            });
        }

        return forms;
    }

