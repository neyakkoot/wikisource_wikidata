    function addHeadword(word) {
        word = normalizeWord(word);
        if (!word || !containsScript(word)) return;

        const exists = rawHeadwordsList.some(item =>
            normalizeWord(item.lemma) === word);

        if (!exists) {
            rawHeadwordsList.push({
                lemma: word,
                language: CURRENT_LANG_QID,
                lexicalCategory: 'Q1084',
                inWiktionary: false,
                wiktionaryContent: '',
                senses: [],
                autoForms: DECLENSION_ENABLED
            });
        }
    }

    function extractWordsFromFirstField(text) {
        if (!text) return [];
        text = String(text).replace(/\u00A0/g, ' ')
            .replace(/[\u200B-\u200D\uFEFF]/g, '').normalize('NFC');

        const words = [];
        const lines = text.split(/\r?\n/).map(x => x.trim()).filter(Boolean);

        lines.forEach(function (line) {
            if (line.includes('=')) line = line.split('=')[0].trim();
            const hm = line.match(/^(.+?)\s+-\s+/);
            if (hm) line = hm[1].trim();
            line = normalizeWord(line);
            if (!line) return;

            const m = line.match(new RegExp('^(' + SCRIPT_RE.source + '[\\s\\S]*?)(?:[\\s,;:|]|$)'));
            if (m) {
                const w = m[1].trim().replace(/[.,:;|]+$/g, '').trim();
                if (w && containsScript(w)) words.push(w);
                return;
            }
            if (containsScript(line)) words.push(line);
        });
        return words;
    }

    function extractHeadwordsFromTables(contentArea) {
        const result = [];
        contentArea.find('table').each(function () {
            $(this).find('tr').each(function () {
                const firstCell = $(this).find('th, td').first();
                if (firstCell.length) {
                    extractWordsFromFirstField(firstCell.text())
                        .forEach(w => result.push(w));
                }
            });
        });
        return result;
    }

    function extractHeadwordsFromNormalText(contentArea) {
        const result = [];
        const clone = contentArea.clone();
        clone.find('table, script, style, noscript, .printfooter, .mw-editsection, .prp-page-header, .prp-page-footer').remove();
        const lines = clone.text().split(/\r?\n/).map(x => x.trim()).filter(Boolean);

        lines.forEach(function (line) {
            if (!containsScript(line)) return;
            if (line.includes('=')) {
                extractWordsFromFirstField(line.split('=')[0].trim())
                    .forEach(w => result.push(w));
                return;
            }
            const hm = line.match(/^(.+?)\s+-\s+/);
            if (hm) {
                extractWordsFromFirstField(hm[1].trim())
                    .forEach(w => result.push(w));
            }
        });
        return result;
    }

    function extractDictionaryHeadwords() {
        const contentArea = $('#mw-content-text').clone();
        contentArea.find('.printfooter, .mw-editsection, style, script, .prp-page-header, .prp-page-footer').remove();

        const allWords = [
            ...extractHeadwordsFromTables(contentArea),
            ...extractHeadwordsFromNormalText(contentArea)
        ];

        const uniqueWords = [];
        const seen = new Set();
        allWords.forEach(function (word) {
            word = normalizeWord(word);
            if (!word || !containsScript(word)) return;
            if (!seen.has(word)) {
                seen.add(word);
                uniqueWords.push(word);
            }
        });
        return uniqueWords;
    }

