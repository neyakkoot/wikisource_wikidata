// ============================================================
// WikiSource Lexeme Creator
// Tamil Dictionary -> Wikidata Lexeme
//
// Features:
// - Dictionary table first-column extraction
// - "=" headword extraction
// - " - " headword extraction
// - Exact Wikidata Lexeme checking
// - Wiktionary POS detection
// - Wikidata / Wiktionary / Commons via mw.ForeignApi
// - Automatic Form F1 creation
// - Wikimedia Commons pronunciation audio detection
// - P443 pronunciation audio
// - P407 Tamil language qualifier
// - Next / Skip workflow
// ============================================================

(function () {
    'use strict';

    // ========================================================
    // CONFIGURATION
    // ========================================================

    const Q_MAP = {
        'Q5885': 'தமிழ் (Q5885)',
        'Q1084': 'பெயர்ச்சொல் (Q1084)',
        'Q24905': 'வினைச்சொல் (Q24905)',
        'Q34698': 'உரிச்சொல் / பெயரடை (Q34698)',
        'Q38005': 'வினையடை (Q38005)'
    };

    const LANG_TAMIL = 'Q5885';

    // Pronunciation audio property
    const P443_PRONUNCIATION_AUDIO = 'P443';

    // Language of work/name qualifier
    const P407_LANGUAGE = 'P407';

    // Supported audio extensions
    const AUDIO_EXTENSIONS = [
        'ogg',
        'oga',
        'opus',
        'wav',
        'flac',
        'mp3'
    ];


    // ========================================================
    // GLOBAL VARIABLES
    // ========================================================

    let rawHeadwordsList = [];
    let filteredLexemesList = [];
    let currentIndex = 0;
    let currentUser = '';

    let wikidataApi = null;
    let wiktionaryApi = null;
    let commonsApi = null;

    let csrfToken = '';


    // ========================================================
    // INITIALIZE FOREIGN APIs
    // ========================================================

    function initializeApis() {

        wikidataApi = new mw.ForeignApi(
            'https://www.wikidata.org/w/api.php'
        );

        wiktionaryApi = new mw.ForeignApi(
            'https://ta.wiktionary.org/w/api.php'
        );

        commonsApi = new mw.ForeignApi(
            'https://commons.wikimedia.org/w/api.php'
        );
    }


    // ========================================================
    // NORMALIZE WORD
    // ========================================================

    function normalizeTamilWord(text) {

        if (!text) {
            return '';
        }

        return String(text)
            .normalize('NFC')
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            .replace(/\u00A0/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }


    // ========================================================
    // CHECK TAMIL TEXT
    // ========================================================

    function containsTamil(text) {

        return /[\u0B80-\u0BFF]/.test(text || '');
    }


    // ========================================================
    // EXTRACT Q-ID
    // ========================================================

    function extractQID(textVal) {

        if (!textVal) {
            return '';
        }

        const match = String(textVal).match(/(Q\d+)/i);

        return match
            ? match[1].toUpperCase()
            : String(textVal).trim();
    }


    // ========================================================
    // ADD WORD WITHOUT DUPLICATE
    // ========================================================

    function addHeadword(word) {

        word = normalizeTamilWord(word);

        if (!word) {
            return;
        }

        if (!containsTamil(word)) {
            return;
        }

        // Ignore obvious page/interface words
        if (
            word.includes('பக்கம்') ||
            word.includes('அகராதி') ||
            word.includes('உள்ளடக்கம்')
        ) {
            return;
        }

        if (word.length < 1) {
            return;
        }

        const exists = rawHeadwordsList.some(function (item) {
            return normalizeTamilWord(item.lemma) === word;
        });

        if (!exists) {

            rawHeadwordsList.push({
                lemma: word,
                language: LANG_TAMIL,
                lexicalCategory: 'Q1084',
                inWiktionary: false,
                wiktionaryContent: ''
            });
        }
    }


    // ========================================================
    // EXTRACT HEADWORD FROM FIRST TABLE CELL
    // ========================================================

    function extractTamilWordsFromFirstField(text) {

        if (!text) {
            return [];
        }

        text = String(text)
            .replace(/\u00A0/g, ' ')
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            .normalize('NFC');

        const words = [];

        const lines = text
            .split(/\r?\n/)
            .map(function (x) {
                return x.trim();
            })
            .filter(Boolean);

        lines.forEach(function (line) {

            if (line.includes('=')) {
                line = line.split('=')[0].trim();
            }

            const hyphenMatch = line.match(/^(.+?)\s+-\s+/);

            if (hyphenMatch) {
                line = hyphenMatch[1].trim();
            }

            line = normalizeTamilWord(line);

            if (!line) {
                return;
            }

            const tamilMatch = line.match(
                /^([\u0B80-\u0BFF][\u0B80-\u0BFF\u0BCD\s]*)/
            );

            if (tamilMatch) {

                let word = tamilMatch[1]
                    .trim()
                    .replace(/[.,:;|]+$/g, '')
                    .trim();

                if (
                    word &&
                    containsTamil(word)
                ) {
                    words.push(word);
                }

                return;
            }

            if (containsTamil(line)) {
                words.push(line);
            }
        });

        return words;
    }


    // ========================================================
    // EXTRACT HEADWORDS FROM TABLES
    // ========================================================

    function extractHeadwordsFromTables(contentArea) {

        const result = [];

        contentArea.find('table').each(function () {

            const table = $(this);

            table.find('tr').each(function () {

                const row = $(this);

                const firstCell = row
                    .find('th, td')
                    .first();

                if (!firstCell.length) {
                    return;
                }

                const text = firstCell.text();

                const words = extractTamilWordsFromFirstField(text);

                words.forEach(function (word) {
                    result.push(word);
                });
            });
        });

        return result;
    }


    // ========================================================
    // EXTRACT "=" AND "-" FORMAT FROM NORMAL TEXT
    // ========================================================

    function extractHeadwordsFromNormalText(contentArea) {

        const result = [];
        const clone = contentArea.clone();

        clone.find(
            'table, script, style, noscript, ' +
            '.printfooter, .mw-editsection, ' +
            '.prp-page-header, .prp-page-footer'
        ).remove();

        const text = clone.text();

        const lines = text
            .split(/\r?\n/)
            .map(function (x) {
                return x.trim();
            })
            .filter(Boolean);

        lines.forEach(function (line) {

            if (!containsTamil(line)) {
                return;
            }

            if (line.includes('=')) {
                const wordPart = line.split('=')[0].trim();
                const words = extractTamilWordsFromFirstField(wordPart);
                words.forEach(function (word) { result.push(word); });
                return;
            }

            const hyphenMatch = line.match(/^(.+?)\s+-\s+/);
            if (hyphenMatch) {
                const wordPart = hyphenMatch[1].trim();
                const words = extractTamilWordsFromFirstField(wordPart);
                words.forEach(function (word) { result.push(word); });
                return;
            }
        });

        return result;
    }


    // ========================================================
    // MAIN DICTIONARY HEADWORD EXTRACTION
    // ========================================================

    function extractDictionaryHeadwords() {

        const contentArea = $('#mw-content-text').clone();

        contentArea.find(
            '.printfooter, .mw-editsection, ' +
            'style, script, .prp-page-header, ' +
            '.prp-page-footer'
        ).remove();

        const allWords = [];

        extractHeadwordsFromTables(contentArea).forEach(function (word) {
            allWords.push(word);
        });

        extractHeadwordsFromNormalText(contentArea).forEach(function (word) {
            allWords.push(word);
        });

        const uniqueWords = [];
        const seen = new Set();

        allWords.forEach(function (word) {
            word = normalizeTamilWord(word);
            if (!word || !containsTamil(word)) return;

            if (!seen.has(word)) {
                seen.add(word);
                uniqueWords.push(word);
            }
        });

        return uniqueWords;
    }


    // ========================================================
    // ADD IMPORT BUTTON
    // ========================================================

    function addImportButton() {

        if ($('#import-lexeme-btn').length > 0) return;

        const btn = $('<button>', {
            id: 'import-lexeme-btn',
            text: 'அகராதிச் சொற்களை விக்கித்தரவில் இணை'
        });

        btn.css({
            'margin': '10px 0',
            'padding': '8px 12px',
            'background-color': '#00af89',
            'color': '#fff',
            'border': 'none',
            'border-radius': '4px',
            'cursor': 'pointer',
            'font-weight': 'bold',
            'z-index': '9999'
        });

        btn.click(processDictionaryPage);

        if ($('#bodyContent').length) {
            $('#bodyContent').prepend(btn);
        } else {
            $('#mw-content-text').before(btn);
        }
    }


    // ========================================================
    // PROCESS DICTIONARY PAGE
    // ========================================================

    function processDictionaryPage() {

        currentUser = mw.config.get('wgUserName');

        if (!currentUser) {
            alert('இந்தப் பங்களிப்பு உங்கள் கணக்கில் சேர நீங்கள் முதலில் உள்நுழைய வேண்டும்.');
            return;
        }

        rawHeadwordsList = [];
        filteredLexemesList = [];
        currentIndex = 0;

        const words = extractDictionaryHeadwords();

        words.forEach(function (word) {
            addHeadword(word);
        });

        if (rawHeadwordsList.length === 0) {
            alert('அகராதித் தலைப்புச் சொற்கள் எதுவும் கண்டறியப்படவில்லை.');
            return;
        }

        $('#import-lexeme-btn')
            .text('விக்கித்தரவு சரிபார்க்கப்படுகிறது...')
            .prop('disabled', true);

        getWikidataToken()
            .then(function () {
                return filterUncreatedLexemes();
            })
            .then(function () {
                if (filteredLexemesList.length === 0) {
                    alert('இப்பக்கத்தில் உள்ள அனைத்து அகராதிச் சொற்களும் ஏற்கனவே விக்கித்தரவில் உருவாக்கப்பட்டுவிட்டன!');
                    $('#import-lexeme-btn').text('அகராதிச் சொற்களை விக்கித்தரவில் இணை').prop('disabled', false);
                    return;
                }
                return batchFetchWiktionaryPOS();
            })
            .then(function (completed) {
                if (completed === false) return;
                showInteractiveModal();
            })
            .catch(function (error) {
                console.error(error);
                $('#import-lexeme-btn').text('அகராதிச் சொற்களை விக்கித்தரவில் இணை').prop('disabled', false);
                alert('API தொடர்பில் பிழை ஏற்பட்டுள்ளது.\n\n' + (error.message || error));
            });
    }


    // ========================================================
    // GET WIKIDATA CSRF TOKEN
    // ========================================================

    function getWikidataToken() {
        return wikidataApi.get({
            action: 'query',
            meta: 'tokens',
            type: 'csrf',
            assert: 'user',
            formatversion: 2
        }).then(function (data) {
            if (data && data.query && data.query.tokens && data.query.tokens.csrftoken) {
                csrfToken = data.query.tokens.csrftoken;
                return true;
            }
            throw new Error('விக்கித்தரவு CSRF token பெற முடியவில்லை.');
        });
    }


    // ========================================================
    // CHECK WHETHER EXACT WIKIDATA LEXEME EXISTS
    // ========================================================

    function checkExactWikidataLexeme(word) {
        return wikidataApi.get({
            action: 'wbsearchentities',
            search: word,
            language: 'ta',
            type: 'lexeme',
            limit: 20,
            formatversion: 2
        }).then(function (data) {
            if (!data || !Array.isArray(data.search)) return false;

            const normalizedSearchWord = normalizeTamilWord(word);

            return data.search.some(function (result) {
                const label = normalizeTamilWord(result.label || '');
                return (label === normalizedSearchWord);
            });
        });
    }


    // ========================================================
    // FILTER EXISTING LEXEMES
    // ========================================================

    function filterUncreatedLexemes() {
        const promises = rawHeadwordsList.map(function (item) {
            return checkExactWikidataLexeme(item.lemma)
                .then(function (exists) {
                    return !exists ? item : null;
                })
                .catch(function (error) {
                    console.warn('Wikidata check failed:', item.lemma, error);
                    return item;
                });
        });

        return Promise.all(promises).then(function (results) {
            filteredLexemesList = results.filter(function (item) { return item !== null; });
            $('#import-lexeme-btn').text('அகராதிச் சொற்களை விக்கித்தரவில் இணை').prop('disabled', false);
            return true;
        });
    }


    // ========================================================
    // GET WIKTIONARY PAGE
    // ========================================================

    function getWiktionaryPage(word) {
        return wiktionaryApi.get({
            action: 'query',
            titles: word,
            redirects: 1,
            prop: 'info|revisions',
            rvprop: 'content',
            rvslots: 'main',
            formatversion: 2
        }).then(function (data) {
            if (!data || !data.query || !Array.isArray(data.query.pages)) {
                return { exists: false, content: '' };
            }

            const page = data.query.pages[0];
            if (!page || page.missing !== undefined) {
                return { exists: false, content: '' };
            }

            let content = '';
            try {
                if (page.revisions && page.revisions[0] && page.revisions[0].slots && page.revisions[0].slots.main) {
                    content = page.revisions[0].slots.main.content || '';
                } else if (page.revisions && page.revisions[0]) {
                    content = page.revisions[0].content || '';
                }
            } catch (e) {
                content = '';
            }

            return { exists: true, content: content, title: page.title || word };
        });
    }


    // ========================================================
    // DETECT WIKTIONARY POS
    // ========================================================

    function detectLexicalCategory(content) {
        if (!content) return 'Q1084';

        if (content.includes('{{பெயர்ச்சொல்}}') || content.includes('=== பெயர்ச்சொல் ===') || content.includes('{{noun}}')) {
            return 'Q1084';
        }
        if (content.includes('{{வினைச்சொல்}}') || content.includes('=== வினைச்சொல் ===') || content.includes('{{verb}}')) {
            return 'Q24905';
        }
        if (content.includes('{{பெயரடை}}') || content.includes('=== பெயரடை ===') || content.includes('{{adjective}}')) {
            return 'Q34698';
        }
        if (content.includes('{{வினையடை}}') || content.includes('=== வினையடை ===') || content.includes('{{adverb}}')) {
            return 'Q38005';
        }

        return 'Q1084';
    }


    // ========================================================
    // FETCH WIKTIONARY DATA FOR ALL WORDS
    // ========================================================

    function batchFetchWiktionaryPOS() {
        const promises = filteredLexemesList.map(function (item) {
            return getWiktionaryPage(item.lemma)
                .then(function (result) {
                    if (result.exists) {
                        item.inWiktionary = true;
                        item.wiktionaryContent = result.content || '';
                        item.wiktionaryTitle = result.title || item.lemma;
                        item.lexicalCategory = detectLexicalCategory(result.content);
                    } else {
                        item.inWiktionary = false;
                        item.wiktionaryContent = '';
                        item.wiktionaryTitle = item.lemma;
                    }
                    return item;
                })
                .catch(function (error) {
                    console.warn('Wiktionary check failed:', item.lemma, error);
                    item.inWiktionary = false;
                    item.wiktionaryContent = '';
                    return item;
                });
        });

        return Promise.all(promises).then(function () { return true; });
    }


    // ========================================================
    // COMMONS: CHECK ONE FILE
    // ========================================================

    function checkCommonsAudioFile(fileName) {
        if (!fileName) return Promise.resolve(null);

        return commonsApi.get({
            action: 'query',
            titles: 'File:' + fileName,
            prop: 'imageinfo',
            iiprop: 'mime',
            formatversion: 2
        }).then(function (data) {
            if (!data || !data.query || !Array.isArray(data.query.pages)) return null;
            const page = data.query.pages[0];
            if (!page || page.missing !== undefined || !page.imageinfo || !page.imageinfo.length) return null;

            const mime = page.imageinfo[0].mime || '';
            if (mime.toLowerCase().indexOf('audio/') === 0) {
                return fileName;
            }
            return null;
        }).catch(function (error) {
            console.warn('Commons audio check failed:', fileName, error);
            return null;
        });
    }


    // ========================================================
    // COMMONS: SEARCH STANDARD TAMIL AUDIO FILENAMES
    // ========================================================

    function findStandardCommonsAudio(word) {
        const candidateFiles = AUDIO_EXTENSIONS.map(function (extension) {
            return 'Ta-' + word + '.' + extension;
        });

        return commonsApi.get({
            action: 'query',
            titles: candidateFiles.join('|'),
            prop: 'imageinfo',
            iiprop: 'mime',
            formatversion: 2
        }).then(function (data) {
            if (!data || !data.query || !Array.isArray(data.query.pages)) return null;

            for (let i = 0; i < data.query.pages.length; i++) {
                const page = data.query.pages[i];
                if (!page || page.missing !== undefined || !page.imageinfo || !page.imageinfo.length) continue;

                const mime = page.imageinfo[0].mime || '';
                if (mime.toLowerCase().indexOf('audio/') === 0) {
                    let fileName = page.title || '';
                    fileName = fileName.replace(/^File:/i, '');
                    return fileName;
                }
            }
            return null;
        }).catch(function (error) {
            console.warn('Commons standard audio search failed:', word, error);
            return null;
        });
    }


    // ========================================================
    // EXTRACT AUDIO FILENAMES FROM WIKTIONARY CONTENT
    // ========================================================

    function extractAudioFilesFromWiktionary(content) {
        if (!content) return [];
        const results = [];
        const regex = /(?:commons\s*:\s*)?(?:File|படிமம்)\s*:\s*([^|\]\n<>"]+\.(?:ogg|oga|opus|wav|flac|mp3))/gi;
        let match;

        while ((match = regex.exec(content)) !== null) {
            const fileName = match[1].trim();
            if (fileName && !results.includes(fileName)) {
                results.push(fileName);
            }
        }
        return results;
    }


    // ========================================================
    // FIND AUDIO REFERENCED BY WIKTIONARY
    // ========================================================

    function findWiktionaryAudio(content) {
        const files = extractAudioFilesFromWiktionary(content);
        if (!files.length) return Promise.resolve(null);

        let promise = Promise.resolve(null);
        files.forEach(function (fileName) {
            promise = promise.then(function (found) {
                if (found) return found;
                return checkCommonsAudioFile(fileName);
            });
        });

        return promise;
    }


    // ========================================================
    // FIND COMMONS PRONUNCIATION AUDIO
    // ========================================================

    function findCommonsPronunciationAudio(word, wiktionaryContent) {
        return findStandardCommonsAudio(word).then(function (standardAudio) {
            if (standardAudio) return standardAudio;
            return findWiktionaryAudio(wiktionaryContent);
        });
    }


    // ========================================================
    // BUILD P443 CLAIM
    // ========================================================

    function buildPronunciationAudioClaim(audioFileName) {
        return {
            mainsnak: {
                snaktype: 'value',
                property: P443_PRONUNCIATION_AUDIO,
                datavalue: {
                    value: audioFileName,
                    type: 'string'
                }
            },
            type: 'statement',
            rank: 'normal',
            qualifiers: {
                P407: [
                    {
                        snaktype: 'value',
                        property: P407_LANGUAGE,
                        datavalue: {
                            value: {
                                'entity-type': 'item',
                                'numeric-id': 5885,
                                'id': 'Q5885'
                            },
                            type: 'wikibase-entityid'
                        }
                    }
                ]
            },
            'qualifiers-order': ['P407']
        };
    }


