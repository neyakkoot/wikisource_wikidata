                            <input type="text" id="input-category" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; box-sizing:border-box;" required />
                        </div>

                        <p style="font-size:11px; color:#555; margin:4px 0;">
                            By clicking "Create Lexeme", you agree to the terms of use, and you irrevocably agree to release your contribution under the Creative Commons CC0 License.
                        </p>

                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
                            <button type="button" id="skip-lexeme-btn" style="padding:8px 16px; background:#72777d; color:#fff; border:none; border-radius:4px; cursor:pointer;">தவிர் (Skip)</button>
                            <button type="button" id="submit-lexeme-btn" style="padding:8px 16px; background:#36c; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">Create Lexeme</button>
                        </div>
                    </form>

                    <div id="status-msg" style="margin-top:10px; font-weight:bold; font-size:13px; text-align:center;"></div>
                </div>
            </div>
        `;

        $('body').append(modalHTML);
        loadCurrentWordToForm();

        $('#modal-close-btn').click(function () { $('#lexeme-modal-overlay').remove(); });
        $('#submit-lexeme-btn').click(submitCurrentLexeme);
        $('#skip-lexeme-btn').click(function () { nextWord(); });
    }


    // ========================================================
    // LOAD CURRENT WORD
    // ========================================================

    function loadCurrentWordToForm() {
        const item = filteredLexemesList[currentIndex];
        if (!item) return;

        $('#current-step-num').text(currentIndex + 1);
        $('#input-lemma').val(item.lemma);
        $('#input-language').val(Q_MAP[LANG_TAMIL]);
        $('#input-category').val(Q_MAP[item.lexicalCategory] || item.lexicalCategory);

        $('#submit-lexeme-btn').prop('disabled', false).text('Create Lexeme');
        $('#skip-lexeme-btn').prop('disabled', false);

        $('#status-msg').text('').css('color', '#00af89');
        $('#audio-status-box').css({ background: '#f8f9fa', borderColor: '#ccc', color: '#555' })
            .html('🔊 Commons ஒலிக்கோப்பு: <strong>உருவாக்கும்போது சரிபார்க்கப்படும்</strong>');

        const statusBox = $('#wiktionary-status-box');

        if (item.inWiktionary) {
            const wiktionaryUrl = 'https://ta.wiktionary.org/wiki/' + encodeURIComponent(item.wiktionaryTitle || item.lemma);
            statusBox.css({ background: '#e6f9ed', borderColor: '#00af89', color: '#006633' })
                .html('📚 தமிழ் விக்சனரியில் இச்சொல் உள்ளது: <a href="' + wiktionaryUrl + '" target="_blank" style="color:#006633; text-decoration:underline;"><strong>' + item.lemma + '</strong></a><br>இலக்கண வகை: <strong>' + (Q_MAP[item.lexicalCategory] || item.lexicalCategory) + '</strong>');
        } else {
            statusBox.css({ background: '#fffbe6', borderColor: '#fc0', color: '#000' })
                .html('⚠️ தமிழ் விக்சனரியில் இச்சொல் இல்லை. இயல்புநிலையாக <strong>' + (Q_MAP[item.lexicalCategory] || item.lexicalCategory) + '</strong> என அமைந்தது.');
        }
    }


    // ========================================================
    // CREATE WIKIDATA LEXEME
    // ========================================================

    function createLexeme(lemmaVal, langVal, catVal, audioFileName) {
        const lexemeData = {
            type: 'lexeme',
            lemmas: { ta: { value: lemmaVal, language: 'ta' } },
            lexicalCategory: catVal,
            language: langVal,
            forms: [
                {
                    add: '',
                    representations: { ta: { language: 'ta', value: lemmaVal } },
                    grammaticalFeatures: []
                }
            ]
        };

        return wikidataApi.post({
            action: 'wbeditentity',
            new: 'lexeme',
            data: JSON.stringify(lexemeData),
            summary: 'Wikisource இலிருந்து உருவாக்கப்பட்டது | பயனர்: ' + currentUser,
            token: csrfToken,
            assert: 'user',
            format: 'json'
        }).then(function (data) {
            if (!data || !data.success || !data.entity || !data.entity.id) {
                throw new Error(data && data.error && data.error.info ? data.error.info : 'Lexeme உருவாக்க முடியவில்லை.');
            }

            const lexemeId = data.entity.id;
            if (!audioFileName) {
                return { lexemeId: lexemeId, formId: null, audioFileName: null };
            }

            return getFirstFormId(lexemeId).then(function (formId) {
                if (!formId) throw new Error('Lexeme உருவாக்கப்பட்டது; ஆனால் Form ID பெற முடியவில்லை.');
                return addPronunciationToForm(formId, audioFileName).then(function () {
                    return { lexemeId: lexemeId, formId: formId, audioFileName: audioFileName };
                });
            });
        });
    }


    // ========================================================
    // GET FIRST FORM ID
    // ========================================================

    function getFirstFormId(lexemeId) {
        return wikidataApi.get({
            action: 'wbgetentities',
            ids: lexemeId,
            props: 'forms',
            formatversion: 2
        }).then(function (data) {
            if (!data || !data.entities) return null;
            const entity = data.entities[lexemeId];
            if (!entity || !entity.forms) return null;

            if (Array.isArray(entity.forms)) {
                return (entity.forms.length && entity.forms[0].id) ? entity.forms[0].id : null;
            }

            const keys = Object.keys(entity.forms);
            return keys.length ? keys[0] : null;
        });
    }


    // ========================================================
    // ADD P443 PRONUNCIATION AUDIO TO FORM
    // ========================================================

    function addPronunciationToForm(formId, audioFileName) {
        const claim = buildPronunciationAudioClaim(audioFileName);

        return wikidataApi.post({
            action: 'wbeditentity',
            id: formId,
            data: JSON.stringify({ claims: [claim] }),
            summary: 'Commons pronunciation audio இணைக்கப்பட்டது | ' + audioFileName,
            token: csrfToken,
            assert: 'user',
            format: 'json'
        }).then(function (data) {
            if (!data || !data.success) {
                throw new Error(data && data.error && data.error.info ? data.error.info : 'P443 சேர்க்க முடியவில்லை.');
            }
            return true;
        });
    }


    // ========================================================
    // SUBMIT CURRENT LEXEME
    // ========================================================

    function submitCurrentLexeme() {
        const lemmaVal = $('#input-lemma').val().trim();
        const rawLangVal = $('#input-language').val().trim();
        const rawCatVal = $('#input-category').val().trim();

        const langVal = extractQID(rawLangVal);
        const catVal = extractQID(rawCatVal);

        if (!lemmaVal || !langVal || !catVal) {
            alert('அனைத்துப் புலங்களையும் நிரப்பவும்.');
            return;
        }

        $('#submit-lexeme-btn').prop('disabled', true).text('உருவாக்கப்படுகிறது...');
        $('#skip-lexeme-btn').prop('disabled', true);
        $('#status-msg').text('🔎 Commons-ல் ஒலிக்கோப்பு தேடப்படுகிறது...').css('color', '#00af89');

        const item = filteredLexemesList[currentIndex];

        findCommonsPronunciationAudio(lemmaVal, item ? item.wiktionaryContent : '')
            .then(function (audioFileName) {
                if (audioFileName) {
                    $('#audio-status-box').css({ background: '#e6f9ed', borderColor: '#00af89', color: '#006633' })
                        .html('🔊 Commons ஒலிக்கோப்பு கண்டறியப்பட்டது: <strong>' + escapeHtml(audioFileName) + '</strong>');
                    $('#status-msg').text('🔊 ஒலிக்கோப்பு கண்டறியப்பட்டது. Lexeme + Form உருவாக்கப்படுகிறது...').css('color', '#00af89');
                } else {
                    $('#audio-status-box').css({ background: '#fffbe6', borderColor: '#fc0', color: '#665500' })
                        .html('🔇 Commons-ல் பொருத்தமான ஒலிக்கோப்பு கிடைக்கவில்லை. Lexeme + Form மட்டும் உருவாக்கப்படும்.');
                    $('#status-msg').text('Lexeme + Form உருவாக்கப்படுகிறது...').css('color', '#00af89');
                }

                return createLexeme(lemmaVal, langVal, catVal, audioFileName);
            })
            .then(function (result) {
                if (!result) return;

                let message = 'வெற்றி: ' + lemmaVal + ' (' + result.lexemeId + ') உருவாக்கப்பட்டது!';
                if (result.audioFileName && result.formId) {
                    message += ' 🔊 P443: ' + result.audioFileName;
                }

                $('#status-msg').html(message).css('color', 'green');

                const lexemeUrl = 'https://www.wikidata.org/wiki/' + result.lexemeId;
                let linkHtml = '<a href="' + lexemeUrl + '" target="_blank" style="color:#36c;">' + result.lexemeId + '</a>';

                if (result.formId) {
                    const formUrl = 'https://www.wikidata.org/wiki/' + result.formId;
                    linkHtml += ' / <a href="' + formUrl + '" target="_blank" style="color:#36c;">' + result.formId + '</a>';
                }

                $('#status-msg').append('<br>' + linkHtml);

                setTimeout(function () { nextWord(); }, 1200);
            })
            .catch(function (error) {
                console.error(error);
                $('#status-msg').text('❌ பிழை: ' + (error.message || error)).css('color', 'red');
                $('#submit-lexeme-btn').prop('disabled', false).text('Create Lexeme');
                $('#skip-lexeme-btn').prop('disabled', false);
            });
    }


    // ========================================================
    // ESCAPE HTML
    // ========================================================

    function escapeHtml(text) {
        return String(text || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }


    // ========================================================
    // NEXT WORD
    // ========================================================

    function nextWord() {
        currentIndex++;
        if (currentIndex < filteredLexemesList.length) {
            loadCurrentWordToForm();
            return;
        }

        alert('அனைத்துப் புதிய சொற்களும் வெற்றிகரமாக உருவாக்கப்பட்டு முடிவடைந்தன!');
        $('#lexeme-modal-overlay').remove();
    }


