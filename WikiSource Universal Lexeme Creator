    // ========================================================

    function addHeadword(word) {
        word = normalizeWord(word);
        if (!word || !containsScript(word)) return;
        if (word.length < 1) return;

        const exists = rawHeadwordsList.some(function (item) {
            return normalizeWord(item.lemma) === word;
        });

        if (!exists) {
            rawHeadwordsList.push({
                lemma: word,
                language: CURRENT_LANG_QID,
                lexicalCategory: 'Q1084',
                inWiktionary: false,
                wiktionaryContent: ''
            });
        }
    }

    // ========================================================
    // 7. உரை பிரித்தெடுத்தல்
    // ========================================================

    function extractWordsFromFirstField(text) {
        if (!text) return [];
        text = String(text)
            .replace(/\u00A0/g, ' ')
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            .normalize('NFC');

        const words = [];
        const lines = text.split(/\r?\n/).map(x => x.trim()).filter(Boolean);

        lines.forEach(function (line) {
            if (line.includes('=')) {
                line = line.split('=')[0].trim();
            }
            const hyphenMatch = line.match(/^(.+?)\s+-\s+/);
            if (hyphenMatch) {
                line = hyphenMatch[1].trim();
            }
            line = normalizeWord(line);
            if (!line) return;

            // மொழி எழுத்தில் தொடங்கும் சொல் மட்டும் எடு
            const m = line.match(new RegExp('^(' + SCRIPT_RE.source + '[\\s\\S]*?)(?:[\\s,;:|]|$)'));
            if (m) {
                let word = m[1].trim().replace(/[.,:;|]+$/g, '').trim();
                if (word && containsScript(word)) words.push(word);
                return;
            }
            if (containsScript(line)) words.push(line);
        });
        return words;
    }

