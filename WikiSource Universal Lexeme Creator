                }
            });
        });
        return result;
    }

    function extractHeadwordsFromNormalText(contentArea) {
        const result = [];
        const clone = contentArea.clone();
        clone.find('table, script, style, noscript, .printfooter, .mw-editsection, .prp-page-header, .prp-page-footer').remove();
        const lines = clone.text().split(/\r?\n/).map(x => x.trim()).filter(Boolean);

        lines.forEach(function (line) {
            if (!containsScript(line)) return;

            if (line.includes('=')) {
                const wordPart = line.split('=')[0].trim();
                extractWordsFromFirstField(wordPart).forEach(w => result.push(w));
                return;
            }
            const hyphenMatch = line.match(/^(.+?)\s+-\s+/);
            if (hyphenMatch) {
                extractWordsFromFirstField(hyphenMatch[1].trim()).forEach(w => result.push(w));
            }
        });
        return result;
    }

    function extractDictionaryHeadwords() {
        const contentArea = $('#mw-content-text').clone();
        contentArea.find('.printfooter, .mw-editsection, style, script, .prp-page-header, .prp-page-footer').remove();

        const allWords = [
            ...extractHeadwordsFromTables(contentArea),
            ...extractHeadwordsFromNormalText(contentArea)
        ];

        const uniqueWords = [];
        const seen = new Set();
        allWords.forEach(function (word) {
            word = normalizeWord(word);
            if (!word || !containsScript(word)) return;
            if (!seen.has(word)) {
                seen.add(word);
                uniqueWords.push(word);
            }
        });
        return uniqueWords;
    }

