    // ========================================================
    // 9. பக்கச் செயலாக்கம்
    // ========================================================

    function processDictionaryPage() {
        currentUser = mw.config.get('wgUserName');
        if (!currentUser) {
            alert(T.loginRequired);
            return;
        }

        rawHeadwordsList = [];
        filteredLexemesList = [];
        currentIndex = 0;
        skippedCount = 0;

        const words = extractDictionaryHeadwords();
        words.forEach(w => addHeadword(w));

        if (rawHeadwordsList.length === 0) {
            alert(T.noWords);
            return;
        }

        $('#import-lexeme-btn').text(T.buttonBusy).prop('disabled', true);

        getWikidataToken()
            .then(() => filterUncreatedLexemes())
            .then(function () {
                if (filteredLexemesList.length === 0) {
                    alert(T.allExist);
                    $('#import-lexeme-btn').text(T.button).prop('disabled', false);
                    return Promise.reject('STOP');
                }
                return batchFetchWiktionaryPOS();
            })
            .then(function (completed) {
                if (completed === false) return;
                showInteractiveModal();
            })
            .catch(function (error) {
                if (error === 'STOP') return;
                console.error(error);
                $('#import-lexeme-btn').text(T.button).prop('disabled', false);
                alert(T.apiError + '\n\n' + (error.message || error));
            });
    }

    // ========================================================
    // 10. CSRF token
    // ========================================================

    function getWikidataToken() {
        return wikidataApi.get({
            action: 'query',
            meta: 'tokens',
            type: 'csrf',
            assert: 'user',
            formatversion: 2
        }).then(function (data) {
            if (data && data.query && data.query.tokens && data.query.tokens.csrftoken) {
                csrfToken = data.query.tokens.csrftoken;
                return true;
            }
            throw new Error(T.errToken);
        });
    }

    // ========================================================
    // 11. ஏற்கனவே உள்ள lexeme சரிபார்ப்பு
    // ========================================================

    function checkExactWikidataLexeme(word) {
        return wikidataApi.get({
            action: 'wbsearchentities',
            search: word,
            language: SITE_LANG,
            type: 'lexeme',
            limit: 20,
            formatversion: 2
        }).then(function (data) {
            if (!data || !Array.isArray(data.search)) return false;
            const norm = normalizeWord(word);
            return data.search.some(function (result) {
                const label = normalizeWord(result.label || '');
                return label === norm;
            });
        });
    }

    function filterUncreatedLexemes() {
        const promises = rawHeadwordsList.map(function (item) {
            return checkExactWikidataLexeme(item.lemma)
                .then(exists => (!exists ? item : null))
                .catch(function (err) {
                    console.warn('Wikidata check failed:', item.lemma, err);
                    return item;
                });
        });

        return Promise.all(promises).then(function (results) {
            filteredLexemesList = results.filter(Boolean);
            $('#import-lexeme-btn').text(T.button).prop('disabled', false);
            return true;
        });
    }

    // ========================================================
    // 12. Wiktionary தரவு
    // ========================================================

    function getWiktionaryPage(word) {
        return wiktionaryApi.get({
            action: 'query',
            titles: word,
            redirects: 1,
            prop: 'info|revisions',
            rvprop: 'content',
            rvslots: 'main',
            formatversion: 2
        }).then(function (data) {
            if (!data || !data.query || !Array.isArray(data.query.pages)) {
                return { exists: false, content: '' };
            }
            const page = data.query.pages[0];
            if (!page || page.missing !== undefined) {
                return { exists: false, content: '' };
            }
            let content = '';
            try {
                if (page.revisions && page.revisions[0] && page.revisions[0].slots && page.revisions[0].slots.main) {
                    content = page.revisions[0].slots.main.content || '';
                } else if (page.revisions && page.revisions[0]) {
                    content = page.revisions[0].content || '';
                }
            } catch (e) { content = ''; }
            return { exists: true, content: content, title: page.title || word };
        });
    }

    function detectLexicalCategory(content) {
        if (!content || !CONFIG) return 'Q1084';
        const posMap = CONFIG.pos;
        for (const qid in posMap) {
            const templates = posMap[qid];
            for (let i = 0; i < templates.length; i++) {
                const t = templates[i];
                if (content.includes('{{' + t + '}}') ||
                    content.includes('===' + t + '===') ||
                    content.includes('=== ' + t + ' ===') ||
                    content.includes('==' + t + '==')) {
                    return qid;
                }
            }
        }
        return 'Q1084';
    }

    function batchFetchWiktionaryPOS() {
        const promises = filteredLexemesList.map(function (item) {
            return getWiktionaryPage(item.lemma)
                .then(function (result) {
                    if (result.exists) {
                        item.inWiktionary = true;
                        item.wiktionaryContent = result.content || '';
                        item.wiktionaryTitle = result.title || item.lemma;
                        item.lexicalCategory = detectLexicalCategory(result.content);
                    } else {
                        item.inWiktionary = false;
                        item.wiktionaryContent = '';
                        item.wiktionaryTitle = item.lemma;
                    }
                    return item;
                })
                .catch(function (err) {
                    console.warn('Wiktionary check failed:', item.lemma, err);
                    item.inWiktionary = false;
                    item.wiktionaryContent = '';
                    return item;
                });
        });
        return Promise.all(promises).then(() => true);
    }

    // ========================================================
    // 13. Commons ஒலி
    // ========================================================

    function checkCommonsAudioFile(fileName) {
        if (!fileName) return Promise.resolve(null);
        return commonsApi.get({
            action: 'query',
            titles: 'File:' + fileName,
            prop: 'imageinfo',
            iiprop: 'mime',
            formatversion: 2
        }).then(function (data) {
            if (!data || !data.query || !Array.isArray(data.query.pages)) return null;
            const page = data.query.pages[0];
            if (!page || page.missing !== undefined || !page.imageinfo || !page.imageinfo.length) return null;
            const mime = (page.imageinfo[0].mime || '').toLowerCase();
            return mime.indexOf('audio/') === 0 ? fileName : null;
        }).catch(function (err) {
            console.warn('Commons audio check failed:', fileName, err);
            return null;
        });
    }

    function findStandardCommonsAudio(word) {
        const candidates = AUDIO_EXTENSIONS.map(ext => AUDIO_PREFIX + '-' + word + '.' + ext);
        return commonsApi.get({
            action: 'query',
            titles: candidates.join('|'),
            prop: 'imageinfo',
            iiprop: 'mime',
            formatversion: 2
        }).then(function (data) {
            if (!data || !data.query || !Array.isArray(data.query.pages)) return null;
            for (let i = 0; i < data.query.pages.length; i++) {
                const page = data.query.pages[i];
                if (!page || page.missing !== undefined || !page.imageinfo || !page.imageinfo.length) continue;
                const mime = (page.imageinfo[0].mime || '').toLowerCase();
                if (mime.indexOf('audio/') === 0) {
                    return (page.title || '').replace(/^File:/i, '');
                }
            }
            return null;
        }).catch(function (err) {
            console.warn('Commons standard audio search failed:', word, err);
            return null;
        });
    }

    function extractAudioFilesFromWiktionary(content) {
        if (!content) return [];
        const results = [];
        // அனைத்து மொழி File: namespaces உம் சேர்த்து
        const nsPattern = FILE_NAMESPACES.map(ns => ns.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
        const regex = new RegExp(
            '(?:commons\\s*:\\s*)?(?:' + nsPattern + ')\\s*:\\s*([^|\\]\\n<>"]+\\.(?:' + AUDIO_EXTENSIONS.join('|') + '))',
            'gi'
        );
        let match;
        while ((match = regex.exec(content)) !== null) {
            const fileName = match[1].trim();
            if (fileName && !results.includes(fileName)) results.push(fileName);
        }
        return results;
    }

    function findWiktionaryAudio(content) {
        const files = extractAudioFilesFromWiktionary(content);
        if (!files.length) return Promise.resolve(null);
        let promise = Promise.resolve(null);
        files.forEach(function (fileName) {
            promise = promise.then(function (found) {
                if (found) return found;
                return checkCommonsAudioFile(fileName);
            });
        });
        return promise;
    }

    function findCommonsPronunciationAudio(word, wiktionaryContent) {
        return findStandardCommonsAudio(word).then(function (standardAudio) {
            if (standardAudio) return standardAudio;
            return findWiktionaryAudio(wiktionaryContent);
        });
    }

    // ========================================================
    // 14. P443 claim
    // ========================================================

    function buildPronunciationAudioClaim(audioFileName) {
        return {
            mainsnak: {
                snaktype: 'value',
                property: P443_PRONUNCIATION_AUDIO,
                datavalue: { value: audioFileName, type: 'string' }
            },
            type: 'statement',
            rank: 'normal',
            qualifiers: {
                P407: [{
                    snaktype: 'value',
                    property: P407_LANGUAGE,
                    datavalue: {
                        value: {
                            'entity-type': 'item',
                            'numeric-id': CURRENT_LANG_NUMERIC,
                            'id': CURRENT_LANG_QID
                        },
                        type: 'wikibase-entityid'
                    }
                }]
            },
            'qualifiers-order': ['P407']
        };
    }

